{
  "name": "@bqw1013/websculpt-plugin",
  "version": "0.3.21",
  "description": "OpenClaw plugin for WebSculpt. Installs the WebSculpt CLI, @playwright/cli, and four lifecycle skills (explore, capture, maintain, library).",
  "type": "module",
  "keywords": [
    "browser automation",
    "web scraping",
    "procedural memory",
    "playwright",
    "self-evolving"
  ],
  "dependencies": {
    "websculpt": "^0.3.10",
    "@playwright/cli": "0.1.13"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "runtimeExtensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
